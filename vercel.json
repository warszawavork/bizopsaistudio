{
  "functions": {
    "api/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/integrations?action=run_telegram_daily_cron",
      "schedule": "0 7 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
